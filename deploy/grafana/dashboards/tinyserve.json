{
  "title": "TinyServe",
  "uid": "tinyserve",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Admission accept/reject rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(admission_accepted_total[1m])", "legendFormat": "accepted" },
        {
          "expr": "rate(admission_rejected_total[1m])",
          "legendFormat": "rejected ({{reason}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "queue_depth", "legendFormat": "waiting" }]
    },
    {
      "id": 3,
      "title": "Batch utilization (actual tokens / max batch capacity)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(batch_utilization_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(batch_utilization_bucket[1m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "KV cache blocks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "kv_blocks_free", "legendFormat": "free" },
        { "expr": "kv_blocks_used", "legendFormat": "used" }
      ]
    },
    {
      "id": 5,
      "title": "Time to first token (TTFT)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(ttft_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ttft_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(ttft_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "Inter-token latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(inter_token_latency_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(inter_token_latency_seconds_bucket[1m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "title": "Decode step duration (llama_decode wall time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(decode_step_duration_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(decode_step_duration_seconds_bucket[1m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(decode_step_duration_seconds_bucket[1m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "title": "Tokens/sec per request",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(tokens_per_second_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, rate(tokens_per_second_bucket[1m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "title": "Scheduler decisions by policy/outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(scheduler_policy_decision_total[1m])",
          "legendFormat": "{{policy}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Cancellations by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "rate(cancellations_total[1m])", "legendFormat": "{{reason}}" }
      ]
    }
  ]
}
